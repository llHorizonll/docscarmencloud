# Carmen RAG API Configuration

# Database
CHROMA_DB_PATH=../carmen_chroma_db
COLLECTION_NAME=carmen_docs_2

# API Server
API_HOST=127.0.0.1
API_PORT=8001

# LLM Settings (OpenRouter)
# Get your API key from: https://openrouter.ai/keys
# Note: LLM is disabled by default. Responses use the formatter for accuracy.
# To enable LLM, pass use_llm=true in query request.
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000

# RAG Settings
DEFAULT_N_RESULTS=5
MAX_N_RESULTS=50
